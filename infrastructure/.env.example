# cp infrastructure/.env.example infrastructure/.env ; chmod 600 infrastructure/.env
# Secrets: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_48_CHARACTERS
TELEMETRY_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_48_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
POSTGRES_DB=drift_telemetry
POSTGRES_USER=drift
TELEMETRY_AGENT_ID=wsl-assetto-agent

# Nome do host deve corresponder ao certificado TLS e ao DNS da sua LAN.
DJANGO_ALLOWED_HOSTS=telemetry.lab.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://telemetry.lab.local:8443

# Por segurança, expõe só no loopback até você decidir habilitar acesso pela LAN.
HTTPS_BIND_IP=127.0.0.1
HTTPS_PORT=8443
