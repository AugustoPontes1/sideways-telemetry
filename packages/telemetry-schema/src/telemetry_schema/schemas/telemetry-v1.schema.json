{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drift-telemetry-lab:telemetry-v1",
  "$defs": {
    "TelemetryFrame": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "timestamp_unix_ns": {
          "type": "integer",
          "minimum": 946684800000000000,
          "maximum": 4102444800000000000
        },
        "timestamp_monotonic_ns": {
          "type": "integer",
          "minimum": 1
        },
        "physics_packet_id": {
          "type": "integer",
          "minimum": 1
        },
        "graphics_packet_id": {
          "type": "integer",
          "minimum": 0
        },
        "session_type": {
          "type": "integer",
          "minimum": -1,
          "maximum": 100
        },
        "completed_laps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "car": {
          "type": "string",
          "maxLength": 160
        },
        "track": {
          "type": "string",
          "maxLength": 160
        },
        "speed_kmh": {
          "type": "number",
          "minimum": -600,
          "maximum": 600
        },
        "speed_mps": {
          "type": "number",
          "minimum": -166.667,
          "maximum": 166.667
        },
        "rpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "gear": {
          "type": "integer",
          "minimum": -1,
          "maximum": 20
        },
        "throttle": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "brake": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clutch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "steer_angle_rad": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "heading_rad": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "pitch_rad": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "roll_rad": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "position_world_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "velocity_world_mps": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "acceleration_g": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "angular_velocity_local_rad_s": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "wheel_slip_raw": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "car_damage": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "minItems": 5,
          "maxItems": 5
        },
        "track_map": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 64
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 0,
              "maxItems": 1200
            },
            "image_url": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^/track-maps/"
            },
            "map_config": {
              "type": "object",
              "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "offset_x": { "type": "number" },
                "offset_z": { "type": "number" },
                "scale_factor": { "type": "number" }
              },
              "required": ["width", "height", "offset_x", "offset_z", "scale_factor"],
              "additionalProperties": false
            }
          },
          "required": ["source", "points"],
          "additionalProperties": false
        },
        "car_visual": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 160
            },
            "display_name": {
              "type": "string",
              "maxLength": 160
            },
            "brand": {
              "type": "string",
              "maxLength": 80
            },
            "asset_key": {
              "type": "string",
              "maxLength": 160
            },
            "source": {
              "type": "string",
              "maxLength": 64
            },
            "ui_metadata": {
              "type": "boolean"
            },
            "model_format": {
              "type": "string",
              "maxLength": 16
            },
            "skin_id": {
              "type": "string",
              "maxLength": 160
            }
          },
          "required": ["id", "display_name", "brand", "asset_key", "source", "ui_metadata", "model_format"],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "timestamp_unix_ns",
        "timestamp_monotonic_ns",
        "physics_packet_id",
        "graphics_packet_id",
        "session_type",
        "completed_laps",
        "car",
        "track",
        "speed_kmh",
        "speed_mps",
        "rpm",
        "gear",
        "throttle",
        "brake",
        "clutch",
        "steer_angle_rad",
        "heading_rad",
        "pitch_rad",
        "roll_rad",
        "position_world_m",
        "velocity_world_mps",
        "acceleration_g",
        "angular_velocity_local_rad_s",
        "wheel_slip_raw"
      ]
    },
    "Sample": {
      "type": "object",
      "properties": {
        "type": {
          "const": "telemetry"
        },
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "received_at_unix_ns": {
          "type": "integer"
        },
        "telemetry": {
          "$ref": "#/$defs/TelemetryFrame"
        }
      },
      "required": [
        "type",
        "stream_id",
        "sequence",
        "received_at_unix_ns",
        "telemetry"
      ]
    },
    "Batch": {
      "type": "object",
      "properties": {
        "type": {
          "const": "telemetry.batch"
        },
        "schema_version": {
          "const": 1
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Sample"
          }
        }
      },
      "required": [
        "type",
        "schema_version",
        "batch_id",
        "agent_id",
        "samples"
      ]
    },
    "Ack": {
      "type": "object",
      "properties": {
        "type": {
          "const": "telemetry.ack"
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "accepted": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "batch_id",
        "accepted"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Batch"
    },
    {
      "$ref": "#/$defs/Ack"
    },
    {
      "$ref": "#/$defs/Sample"
    }
  ]
}
